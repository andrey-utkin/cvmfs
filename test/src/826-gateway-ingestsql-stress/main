#!/bin/bash
cvmfs_test_name="Mountless repository gateway ingest: parallel stress test"
cvmfs_test_autofs_on_startup=false
cvmfs_test_suites="quick" # takes about 4 minutes to fail, maybe will be done in 10 minutes if pass

TEST_SRC_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# produce_db() {
#   local db_path=$1
#   local dir=$2
#   cvmfs_swissknife ingestsql -D '' -N '' -n "$db_path"
#   sqlite3 "$db_path" <<EOF
#   INSERT INTO dirs (name) VALUES ('$dir');
# EOF
# }

ingest_lots() {
  local base=$1
  local n=$2

  mkdir "$base"

  local DIRS_CREATED=()
  for i in $(seq 1 "$n"); do
    dirno=$(printf %05d "$i")
    dir=$base."$dirno"
    DIRS_CREATED+=("$dir")
  done
  PARALLEL_JOBS=$(nproc) # starts failing on 330+ item, on 28 cores
  export CVMFS_TEST_REPO CVMFS_TEST_PROXY CVMFS_TEST_HTTP_BASE CVMFS_TEST_S3_CONFIG CVMFS_SPOOL_DIR
  printf '%s\n' "${DIRS_CREATED[@]}" | xargs --verbose --max-procs="$PARALLEL_JOBS" -I {} -- "$TEST_SRC_DIR"/ingestsql_invocation {} &
  XARGS_PID=$!
  echo $XARGS_PID > xargs.pid
  wait "$XARGS_PID"

  rm -rf "$base"

  echo "*** mountless ingest should not remount the publisher view"
  cat /proc/mounts | grep -e " /cvmfs/$CVMFS_TEST_REPO " && return 21
  cat /proc/mounts | grep -e " ${CVMFS_SPOOL_DIR}/rdonly " && return 22
  [ ! -f "$CVMFS_SPOOL_DIR"/session_token ] || return 23

  echo "*** verify published artifacts"
  #cvmfs_server check -i "$CVMFS_TEST_REPO" # debug output considered errors?
  check_repo_integrity "$CVMFS_TEST_REPO"

  sudo mount "$CVMFS_SPOOL_DIR"/rdonly
  pushd "$CVMFS_SPOOL_DIR"/rdonly
  local DIRS_PRESENT=( "$base".* )
  popd # "$CVMFS_SPOOL_DIR"/rdonly
  for i in $(seq 0 $(( n - 1 )) ); do
    [[ "${DIRS_CREATED[$i]}" == "${DIRS_PRESENT[$i]}" ]]
  done
  sudo umount "$CVMFS_SPOOL_DIR"/rdonly
}

cvmfs_run_test() {
  if ! [[ -v CVMFS_TEST_S3_CONFIG ]]; then
    echo "This test does not have S3 setup, can't run this test, skipping it."
    CVMFS_GENERAL_WARNING_FLAG=1
    return 0
  fi

  # set_up_repository_gateway() is hardcoded to test.repo.org as of 2026-10-09
  # Redefine to match that.
  CVMFS_TEST_REPO=test.repo.org

  export CVMFS_TEST_REPO # for proxyctl

  set_up_repository_gateway -P || return 1
  load_repo_config "$CVMFS_TEST_REPO" || return 2

  echo "*** check bootstrap leaves the repository unmounted"
  cat /proc/mounts | grep -e " /cvmfs/$CVMFS_TEST_REPO " && return 3
  cat /proc/mounts | grep -e " ${CVMFS_SPOOL_DIR}/rdonly " && return 4

  echo "*** ingest SQL without a publisher mount"
  #produce_tarball "$tarfile" || return 10

  local n=1000
  cvmfs_swissknife ingestsql -D "" -N "" -n ingestsql_template.db
  #ingest_lots "direct" "$n" # disabled as not challenging, but should work
  #"$TEST_ROOT"/common/proxyctl enable_now
  #ingest_lots "proxied" "$n" # disabled as not challenging, but should work
  PROXY_TCP_RST=1 "$TEST_ROOT"/common/proxyctl enable_now
  ingest_lots "proxied_rst" "$n"
}
