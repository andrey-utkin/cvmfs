CVMFS_CACHE_BASE=/var/cache/cvmfs
CVMFS_CACHE_SYMLINKS=no
CVMFS_CLAIM_OWNERSHIP=no
CVMFS_DUMMY_STATFS=1
CVMFS_ENFORCE_ACLS=true
CVMFS_EXTERNAL_URL=http://127.0.0.1:8000/test.repo/test.repo
CVMFS_SERVER_URL=http://127.0.0.1:8000/test.repo/test.repo
CVMFS_HIDE_MAGIC_XATTRS=no
CVMFS_HTTP_TRACING=on
CVMFS_HTTP_PROXY=http://127.0.0.1:8088
CVMFS_LIBFUSE=3
CVMFS_REPOSITORY_NAME=test.repo
CVMFS_SERVER_CATALOG_CACHE=on
CVMFS_TELEMETRY_RATE=20
CVMFS_TELEMETRY_SEND=on
CVMFS_INFLUX_EXTRA_FIELDS=
CVMFS_INFLUX_EXTRA_TAGS=percent_rollout=15,os_version=9
CVMFS_INFLUX_HISTOGRAMS=on
CVMFS_INFLUX_HOST=127.0.0.1
CVMFS_INFLUX_METRIC_NAME=cvmfs_client_counters_new
CVMFS_INFLUX_PORT=8092

