    (
        source $TEST_ROOT/test_functions
        apache_switch on
    )

    #sudo cvmfs_server mkfs -o "$CVMFS_TEST_USER" -w "$CVMFS_TEST_HTTP_BASE" -s "$CVMFS_TEST_S3_CONFIG" "$CVMFS_TEST_REPO"
    sudo cp /etc/cvmfs/keys/"$CVMFS_TEST_REPO".pub /etc/cvmfs-gateway-client/"$CVMFS_TEST_REPO"/pubkey

    sudo cvmfs_server transaction "$MY_REPO"
    sudo mkdir -p /cvmfs/"$MY_REPO"/TEST_DIRECTORY/DIR{1,2,3}
    for subdir in . DIR{1,2,3}; do
        for file in /cvmfs/"$MY_REPO"/TEST_DIRECTORY/"$subdir"/file{1,2,3}; do
        echo OH HI | sudo tee "$file"
        done
    done
    sudo cvmfs_server publish "$MY_REPO"
    sudo cvmfs_config umount # or: fusermount -u /var/spool/cvmfs/"$MY_REPO"/rdonly
    sudo umount /cvmfs/$MY_REPO

else # ! [[ -v RECONSTRUCT_REPO ]]
    sudo touch /etc/fstab # absense of /etc/fstab on CentOS 9 containers breaks `cvmfs_server migrate`
    sudo mkdir -p /var/spool/cvmfs/"$CVMFS_TEST_REPO"
    sudo rsync -rtv "$this_script_dir"/var/spool/cvmfs/test.repo/{reflog.chksum,tmp}  /var/spool/cvmfs/"$CVMFS_TEST_REPO"
    #sudo mkdir -p /var/http/root/"$CVMFS_TEST_REPO"/
