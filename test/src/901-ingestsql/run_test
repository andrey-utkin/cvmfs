# Check that HTTP servers serve expected contents:
diff -Nurd "$this_script_dir"/var/http/root/test.repo/"$CVMFS_TEST_REPO"/.cvmfspublished <(curl --disable --verbose --fail "$CVMFS_TEST_HTTP_BASE"/$CVMFS_TEST_REPO/.cvmfspublished)
if [[ "$S3_SERVER_PROVIDED" == 0 ]]; then
    diff -Nurd "$this_script_dir"/var/http/root/test.repo/"$CVMFS_TEST_REPO"/.cvmfspublished <(curl --disable --verbose --fail --proxy http://localhost:8088 "$CVMFS_TEST_HTTP_BASE"/$CVMFS_TEST_REPO/.cvmfspublished)
fi

