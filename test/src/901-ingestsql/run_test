    if [[ "$S3_SERVER_PROVIDED" == 1 ]]; then
        pushd "$this_script_dir"/var/http/root/test.repo/
        find test.repo/ -type f -print0 | xargs --verbose -0 -I '{}' s3cmd put '{}' s3://"$CVMFS_S3_BUCKET"/'{}'
        popd
    fi
    sudo rsync -rtv "$this_script_dir"/etc/cvmfs/{repositories.d,keys}  /etc/cvmfs
    sudo tee -a /etc/cvmfs/repositories.d/"$CVMFS_TEST_REPO"/server.conf <<EOF
CVMFS_UPSTREAM_STORAGE=S3,/var/spool/cvmfs/$CVMFS_TEST_REPO/tmp,$CVMFS_TEST_REPO@$CVMFS_TEST_S3_CONFIG
CVMFS_STRATUM0=$CVMFS_TEST_HTTP_BASE/$CVMFS_TEST_REPO
CVMFS_SERVER_PROXY=DIRECT
EOF
    sudo tee -a /etc/cvmfs/repositories.d/"$CVMFS_TEST_REPO"/client.conf <<EOF
CVMFS_SERVER_URL=$CVMFS_TEST_HTTP_BASE/$CVMFS_TEST_REPO
CVMFS_EXTERNAL_URL=$CVMFS_TEST_HTTP_BASE/$CVMFS_TEST_REPO
CVMFS_HTTP_PROXY=DIRECT
EOF
    sudo tee -a /etc/cvmfs/config.d/"$CVMFS_TEST_REPO".local <<EOF
CVMFS_SERVER_URL=$CVMFS_TEST_HTTP_BASE/$CVMFS_TEST_REPO
CVMFS_EXTERNAL_URL=$CVMFS_TEST_HTTP_BASE/$CVMFS_TEST_REPO
CVMFS_HTTP_PROXY=DIRECT
EOF
    sudo /usr/lib/systemd/system-generators/systemd-fstab-generator /run/systemd/generator '' '' || true
    sudo systemctl daemon-reload
    sudo -E bash -x cvmfs_server resign "$CVMFS_TEST_REPO"
